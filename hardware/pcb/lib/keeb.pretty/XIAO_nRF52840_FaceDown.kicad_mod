(footprint "XIAO_nRF52840_FaceDown"
	(version 20260206)
	(generator "pcbnew")
	(generator_version "10.0")
	(layer "F.Cu")
	(descr "Seeed XIAO nRF52840 mounted face-down over a board cutout. Castellated pads only; the battery and SWD back pads face up and are hand-wired. Pin order is mirrored vs face-up: seen from above, D0 is top-right next to USB-C. Pin grid and parts envelope from Seeed's v1.1 KiCad layout and STEP model. Dwgs.User shows the cutout: copy it onto Edge.Cuts, open at the USB-C end. The rule area keeps copper off the main board past the antenna end.")
	(tags "seeed xiao nrf52840 ble face-down castellated")
